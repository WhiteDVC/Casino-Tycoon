local function CreateBot(folder, spawnPoint)
	task.spawn(function()
		local bot = Bots:GetChildren()[math.random(1,#Bots:GetChildren())]
		bot = bot:Clone()
		bot.Parent = folder
		
		local humanoid : Humanoid = bot:WaitForChild("Humanoid")
		local humanoidRootPart : BasePart = bot:WaitForChild("HumanoidRootPart")
		local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 6, AgentCanJump = false, AgentCanClimb = false, WaypointSpacing = 5})
		local waypoints = {}
		local function moveTo(target, value)
			path:ComputeAsync(humanoidRootPart.Position,target)
			if path.Status == Enum.PathStatus.Success then 
				waypoints = path:GetWaypoints()
				if value then
					value.Value = true
				end
				for _, waypoint in waypoints do
					humanoid:MoveTo(waypoint.Position)
					task.wait(.55)
				end
			else
				return true
			end
		end
		local Waypoints = folder.Parent:WaitForChild("Waypoints")
		local Waypoint1 = Waypoints:WaitForChild("Waypoint1")
		local Waypoint2 = Waypoints:WaitForChild("Waypoint2")
		local MinX = math.min(Waypoint1.Position.X, Waypoint2.Position.X)
		local MinZ = math.min(Waypoint1.Position.Z, Waypoint2.Position.Z)
		local MaxX = math.max(Waypoint1.Position.X, Waypoint2.Position.X)
		local MaxZ = math.max(Waypoint1.Position.Z, Waypoint2.Position.Z)
		local Stuff : Folder = folder.Parent:WaitForChild("Stuff")
		
		local function RandomPosition()
			local x = math.round(math.random(MinX, MaxX) / 5) * 5
			local z = math.round(math.random(MinZ, MaxZ) / 5) * 5
			return Vector3.new(x, humanoidRootPart.Position.Y, z)
		end
		local function MoveRandom()
			local random = true
			repeat
				random = moveTo(RandomPosition())
				task.wait()
			until random == nil
		end
		
		local function CheckGames()
			local list = {}
			local Stuff = Stuff:GetDescendants()
			for _,v in Stuff do
				if v:IsA("BoolValue") and v.Name == "Active" then
					if not v.Value then
						table.insert(list,v)
					end
				end
			end
			if #list > 0 then
				return list[math.random(1,#list)]
			end
			return nil
		end
		
		local function Play()
			local selectedGame = CheckGames()
			if selectedGame then
				if moveTo(selectedGame.Parent.Position, selectedGame) then
					MoveRandom()
					return
				end
				task.wait(.5)
				if not selectedGame.Parent then
					MoveRandom()
					return
				end
				humanoidRootPart.CFrame = selectedGame.Parent.CFrame
				selectedGame:SetAttribute("Using", true)
				
				if selectedGame:GetAttribute("Type") == "Machine" then
					local function PlayMachine()
						local Wheel1 : Motor6D = selectedGame.Parent.Parent:WaitForChild("Part"):WaitForChild("Wheel1")
						local Wheel2 : Motor6D = selectedGame.Parent.Parent:WaitForChild("Part"):WaitForChild("Wheel2")
						local Wheel3 : Motor6D = selectedGame.Parent.Parent:WaitForChild("Part"):WaitForChild("Wheel3")
						local n = math.random(1,3)
						local n1
						local n2
						local n3
						if n == 3 then
							n1 = 4
							n2 = 4
							n3 = 4
						else
							local id = false
							repeat
								n1 = math.random(1,4)
								n2 = math.random(1,4)
								n3 = math.random(1,4)
								
								if n1 == 4 and n2 == 4 and n3 == 4 then
									id = false
								else
									id = true
								end
							until id
						end
						
						local w1 = Wheel1:GetAttribute("Rotation")
						local w2 = Wheel2:GetAttribute("Rotation")
						local w3 = Wheel3:GetAttribute("Rotation")
						Wheel1:SetAttribute("Rotation", n1)
						Wheel2:SetAttribute("Rotation", n2)
						Wheel3:SetAttribute("Rotation", n3)
						
						local r1
						local r2
						local r3
						if n1 < w1 then
							r1 = (n1 + 4) - w1 + 8
						else
							r1 = n1 - w1 + 8
						end
						if n2 < w2 then
							r2 = (n2 + 4) - w2 + 12
						else
							r2 = n2 - w2 + 12
						end
						if n3 < w3 then
							r3 = (n3 + 4) - w3 + 16
						else
							r3 = n3 - w3 + 16
						end
						r1 = r1 * 90
						r2 = r2 * 90
						r3 = r3 * 90
						
						task.wait(0.7)
						task.spawn(function()
							selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Wheel"):Play()
							task.wait(6.4)
							selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Wheel"):Stop()
						end)
						task.wait(0.3)
						for i = 1, 60 do
							Wheel1.C0 = Wheel1.C0 * CFrame.Angles(math.rad(-r1 / 60),0,0)
							Wheel2.C0 = Wheel2.C0 * CFrame.Angles(math.rad(-r2 / 80),0,0)
							Wheel3.C0 = Wheel3.C0 * CFrame.Angles(math.rad(-r3 / 100),0,0)
							task.wait(.05)
						end
						for i = 1, 20 do
							Wheel2.C0 = Wheel2.C0 * CFrame.Angles(math.rad(-r2 / 80),0,0)
							Wheel3.C0 = Wheel3.C0 * CFrame.Angles(math.rad(-r3 / 100),0,0)
							task.wait(.05)
						end
						for i = 1, 20 do
							Wheel3.C0 = Wheel3.C0 * CFrame.Angles(math.rad(-r3 / 100),0,0)
							task.wait(.05)
						end
						
						task.spawn(function()
							
							if n ~= 3 then
								selectedGame.Parent.Parent:WaitForChild("Money").Value += 20
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Board"):WaitForChild("Win").Visible = true
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Ding"):Play()
								task.wait(2)
								if not selectedGame.Parent then return end
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Board"):WaitForChild("Win").Visible = false
							else
								selectedGame.Parent.Parent:WaitForChild("Money").Value -= 20
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Board"):WaitForChild("Lose").Visible = true
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Ding"):Play()
								task.wait(2)
								if not selectedGame.Parent then return end
								selectedGame.Parent.Parent:WaitForChild("Text"):WaitForChild("Board"):WaitForChild("Lose").Visible = false
							end
						end)
					end
					
					PlayMachine()
					--[[local n = math.random(1,10)
					if n <= 6 then
						PlayMachine()
					end]]
					
					selectedGame.Value = false
					selectedGame:SetAttribute("Using", false)
					MoveRandom()
				end
				
			else
				MoveRandom()
			end
		end
		local function Leave()
			local random = true
			repeat
				random = moveTo(spawnPoint.Position)
				task.wait()
			until random == nil
			bot:Destroy()
		end
		
		--BEHAVIOR
		humanoidRootPart.CFrame = spawnPoint.CFrame
		
		Play()
		task.wait(5)
		Play()
		task.wait(5)
		Play()
		task.wait(5)
		Leave()
		
	end)
end

