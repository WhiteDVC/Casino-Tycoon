local function SavePlotFunction(plot: Folder, UserId)
	local e,m = pcall(function()
		
			
		local Stuff = plot:FindFirstChild("Stuff")
		local StuffData = {}
		local Index = plot:FindFirstChild("Index")
		for _, object: Model in Stuff:GetChildren() do
			table.insert(StuffData,{
				Name = object.Name;
				cframe = {Index.CFrame:ToObjectSpace(object:GetPivot()):GetComponents()}
			})
		end
		PlotData:SetAsync(UserId,StuffData)
	end)
	if not e then warn(m) end
end
local function LoadPlot(UserId,plot)
	local e,m = pcall(function()
		local getData = PlotData:GetAsync(UserId)

		local Index = plot:FindFirstChild("Index")

		if getData then
			for _, object in getData do
				local model = ServerStorage:FindFirstChild(object.Name)
				if not model then continue end
				local clone = model:Clone()
				clone:PivotTo(Index.CFrame:ToWorldSpace(CFrame.new(table.unpack(object.cframe))))
				clone.Parent = plot:FindFirstChild("Stuff")
			end
		end
	end)
	if not e then warn(m) end
end
ClaimPlot.OnServerEvent:Connect(function(player, plotName)
	local plot = Plots:FindFirstChild(plotName)
	if not plot then return end
	if plot.Value ~= "Empty" then player:Kick("There was an error, please join again! :)") end
	if plot.Value ~= "Empty" then return end
	
	ClaimPlot:FireClient(player,plot.Name)
	
	plot.Value = player.Name
	if plot.Name == "Base1" then
		player.Character.HumanoidRootPart.CFrame = Spawn1.CFrame
	elseif plot.Name == "Base2" then
		player.Character.HumanoidRootPart.CFrame = Spawn2.CFrame
	elseif plot.Name == "Base3" then
		player.Character.HumanoidRootPart.CFrame = Spawn3.CFrame
	elseif plot.Name == "Base4" then
		player.Character.HumanoidRootPart.CFrame = Spawn4.CFrame
	elseif plot.Name == "Base5" then
		player.Character.HumanoidRootPart.CFrame = Spawn5.CFrame
	elseif plot.Name == "Base6" then
		player.Character.HumanoidRootPart.CFrame = Spawn6.CFrame
	end
	LoadPlot(player.UserId,Base1)
	
end)

SavePlot.OnServerEvent:Connect(function(player,plot)
	print(plot)
	SavePlotFunction(plot,player.UserId)
	SavePlot:FireClient(player)
end)

Place.OnServerEvent:Connect(function(player,objectName,cframe,plot)
	local e,m = pcall(function()
		local plot = Plots:FindFirstChild(plot.Name)
		if not plot then return end
		if plot.Value ~= player.Name then return end
		local object = Objects:FindFirstChild(objectName)
		if not object then return end
		local clone = object:Clone()
		clone:PivotTo(cframe)
		clone.Parent = plot:FindFirstChild("Stuff")
	end)
	if not e then print(m) end
end)
