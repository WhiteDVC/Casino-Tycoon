local Moving = false
local NewObject = nil
local NewPart = nil
local appliedRotation = CFrame.Angles(0, math.rad(0), 0)
local rotateFunction
local raycastParams = RaycastParams.new()
raycastParams.FilterType = Enum.RaycastFilterType.Exclude
local function StartMoving(object)
	local clone = Objects:FindFirstChild(object)
	if not clone then warn("Not found clone") end
	if not clone then return end
	clone = clone:Clone()
	clone.Parent = workspace
	
	NewObject = clone
	NewPart = clone.PrimaryPart
	
	Moving = true
	task.spawn(function()
		repeat
			task.wait(.1)
			local raycast = workspace:Raycast(Camera.CFrame.Position,Mouse.Hit.LookVector * 100,raycastParams)
			if raycast then
				local vector3 = raycast.Position
				local x = vector3.X
				local y = vector3.Y
				local z = vector3.Z
				x = math.round(x / 5) * 5
				y = math.round(y)
				z = math.round(z / 5) * 5
				vector3 = Vector3.new(x,y,z)
				if NewObject then
					TweenService:Create(NewObject.PrimaryPart,TInfo2,{CFrame = CFrame.new(vector3) * appliedRotation}):Play()
				end
			end
		until not Moving
	end)
end
local function StopMoving()
	Moving = false
	NewObject:Destroy()
	NewObject = nil
	NewPart = nil
end



UserInputService.InputBegan:Connect(function(input, gameProcessed)
	if input.KeyCode == Enum.KeyCode.R and Moving then
		if appliedRotation == CFrame.Angles(0, math.rad(0), 0) then
			appliedRotation = CFrame.Angles(0, math.rad(90), 0)
		elseif appliedRotation == CFrame.Angles(0, math.rad(90), 0) then
			appliedRotation = CFrame.Angles(0, math.rad(180), 0)
		elseif appliedRotation == CFrame.Angles(0, math.rad(180), 0) then
			appliedRotation = CFrame.Angles(0, math.rad(270), 0)
		elseif appliedRotation == CFrame.Angles(0, math.rad(270), 0) then
			appliedRotation = CFrame.Angles(0, math.rad(0), 0)
		end
		
		local raycast = workspace:Raycast(Camera.CFrame.Position,Mouse.Hit.LookVector * 100,raycastParams)
		if raycast then
			local vector3 = raycast.Position
			local x = vector3.X
			local y = vector3.Y
			local z = vector3.Z
			x = math.round(x / 5) * 5
			y = math.round(y)
			z = math.round(z / 5) * 5
			vector3 = Vector3.new(x,y,z)
			if NewObject then
				TweenService:Create(NewObject.PrimaryPart,TInfo2,{CFrame = CFrame.new(vector3) * appliedRotation}):Play()
			end
		end
	end
end)
