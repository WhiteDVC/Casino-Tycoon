local TInfoSpend = TweenInfo.new(0.75,Enum.EasingStyle.Linear,Enum.EasingDirection.In,0,false,0)
local function spendMoney(amount, message)
	task.spawn(function()
		if not message then
			if amount < 0 then
				local clone = Spend:Clone()
				clone.Text = tostring(amount)
				clone.TextColor3 = Color3.fromRGB(255,0,0)
				clone.Parent = Spend.Parent
				local spendTween = TweenService:Create(clone,TInfoSpend,{TextTransparency = 1,Position = UDim2.new(0.5,0,0,100)})
				clone.Visible = true
				spendTween:Play()
				task.wait(.5)
				clone:Destroy()
			end
			if amount > 0 then
				local clone = Spend:Clone()
				clone.Text = "+" .. tostring(amount)
				clone.TextColor3 = Color3.fromRGB(0,255,0)
				clone.Parent = Spend.Parent
				local spendTween = TweenService:Create(clone,TInfoSpend,{TextTransparency = 1,Position = UDim2.new(0.5,0,0,100)})
				clone.Visible = true
				spendTween:Play()
				task.wait(.5)
				clone:Destroy()
			end
		else
			PlaySound(Error)
			local clone = Spend:Clone()
			clone.Text = tostring(message)
			clone.TextColor3 = Color3.fromRGB(255,0,0)
			clone.Parent = Spend.Parent
			local spendTween = TweenService:Create(clone,TInfoSpend,{TextTransparency = 1,Position = UDim2.new(0.5,0,0,100)})
			clone.Visible = true
			spendTween:Play()
			task.wait(.5)
			clone:Destroy()
		end
	end)
end
