local function getPlayer(Base)
	if not Base then return end
	if not Base:IsA("StringValue") then return end
	return Base.Value
end
local function setBaseName(Base)
	if not Base then return end
	BaseName.Text = getPlayer(Base)
	task.spawn(function()
		task.wait(1)
		if getPlayer(Base) == "Empty" then
			Claim.Visible = true
		end
	end)
end
