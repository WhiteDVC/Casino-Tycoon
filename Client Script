local saving = false
SaveSave.Activated:Connect(function()
	saving = true
	SaveSave.Visible = false
	SaveLoading.Visible = true
	SavePlot:FireServer(selectedPlot)
	task.spawn(function()
		repeat
			TweenService:Create(SaveLoading, TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.In,0,false,0),{Rotation = 180}):Play()
			task.wait(.5)
			SaveLoading.Rotation = -180
			TweenService:Create(SaveLoading, TweenInfo.new(0.5,Enum.EasingStyle.Linear,Enum.EasingDirection.In,0,false,0),{Rotation = 0}):Play()
			task.wait(.5)
		until not saving
		SaveSave.Visible = true
		SaveLoading.Visible = false
	end)
end)
