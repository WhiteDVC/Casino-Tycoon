local function StartMoving(object)
	baseTexture.Transparency = 0
	xAlign = Rotations[object]["xAlign"]
	zAlign = Rotations[object]["zAlign"]
	MovingText.Visible = true
	local clone = Objects:FindFirstChild(object)
	if not clone then warn("Not found clone") end
	if not clone then return end
	clone = clone:Clone()
	clone.Parent = workspace
	
	NewObject = clone
	NewPart = clone.PrimaryPart
	
	Moving = true
	task.spawn(function()
		local e,m = pcall(function()
			repeat
				task.wait(.1)
				local raycast = workspace:Raycast(Camera.CFrame.Position,Mouse.Hit.LookVector * 100,raycastParams)
				if raycast then
					local vector3 = raycast.Position
					local x = vector3.X
					local y = vector3.Y
					local z = vector3.Z
					if appliedRotation == CFrame.Angles(0, math.rad(90), 0) or appliedRotation == CFrame.Angles(0, math.rad(270), 0) then
						x = math.round((x - xAlign) / 5) * 5 + xAlign
						y = math.round(y)
						z = math.round((z - zAlign) / 5) * 5 + zAlign
					else
						x = math.round((x - zAlign) / 5) * 5 + zAlign
						y = math.round(y)
						z = math.round((z - xAlign) / 5) * 5 + xAlign
					end
					vector3 = Vector3.new(x,NewObject:GetAttribute("Height"),z)
					if NewObject then
						TweenService:Create(NewObject.PrimaryPart,TInfo2,{CFrame = CFrame.new(vector3) * appliedRotation}):Play()
					end
				end
			until not Moving
		end)
	end)
end
local function StopMoving()
	baseTexture.Transparency = 1
	xAlign = 0
	zAlign = 0
	Moving = false
	if NewObject then
		NewObject:Destroy()
	end
	NewObject = nil
	NewPart = nil
